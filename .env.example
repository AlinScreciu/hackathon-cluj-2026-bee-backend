# Server
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_CONN_STR=postgres://radarul:radarul@localhost:5432/radarul?sslmode=disable

# JWT — must be at least 32 chars in production
JWT_SECRET=change-me-in-production-32-chars-min

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_PHONE=+40xxxxxxxxx

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Web Push (VAPID) — generate with: make gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email — Resend (https://resend.com)
# SMTP: smtp.resend.com:465, user=apikey, pass=RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@beelive.ro

# Primărie email recipient (use Mailtrap or a real inbox)
PRIMARIE_EMAIL=primarie@beelive.ro

# AI Geo Service — leave empty to use mock
GEO_AI_BASE_URL=

# Cloudflare R2 — voice MP3 cache for production. Leave all empty to use
# local disk under ./uploads/voice (fine for dev, breaks on multi-instance
# or ephemeral-filesystem deploys).
#
# Bucket is kept PRIVATE — voice MP3s contain beekeeper first names + apiary
# names (GDPR personal data). URLs handed to Twilio are short-lived S3
# presigned GETs, so do NOT enable Public Access on the bucket.
#
# - R2_ACCOUNT_ID: dashboard → R2 → "Account ID" in the right-hand sidebar
# - R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: dashboard → R2 → Manage R2 API Tokens
# - R2_BUCKET: e.g. "beelive-voice"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
